{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "demolay-quiz",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Node.js APIs (Payload needs them)
    "nodejs_compat",
    // Allow fetching public URLs from the Worker
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Comma separated emails allowed to create an admin account. Required in production.
    "ADMIN_EMAILS": "",
    // Public OAuth client ID from Google Cloud Console (not secret).
    // The matching secret is set with: npx wrangler secret put GOOGLE_CLIENT_SECRET
    "GOOGLE_CLIENT_ID": "",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "demolay-quiz",
      // Replace with the id printed by: npx wrangler d1 create demolay-quiz
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "demolay-quiz",
    },
  ],
}
