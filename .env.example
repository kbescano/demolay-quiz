# Payload needs a long random secret. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Local development only. In production this is set in wrangler.jsonc ("vars") and a Worker secret.
ADMIN_EMAILS=

# Google sign-in (players). Create an OAuth client at console.cloud.google.com
# Redirect URI for local use: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
