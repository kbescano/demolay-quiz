# Payload signs sessions with this. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Comma separated emails allowed to create an admin account. Required in production.
ADMIN_EMAILS=

# Google sign-in for players. Create an OAuth client at console.cloud.google.com
# Redirect URI for local use: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Production only (set these in Netlify, not here) ----
# Turso database. Leave empty locally: the app then uses the file ./local.db
DATABASE_URI=
DATABASE_AUTH_TOKEN=
# The site's public address, for example https://your-site.netlify.app
APP_URL=
